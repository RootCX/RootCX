FROM oven/bun:1.3.10@sha256:b86c67b531d87b4db11470d9b2bd0c519b1976eee6fcd71634e73abfa6230d2e AS bun
FROM rust:1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa

ARG TARGETARCH
ARG NEXTEST_VERSION=0.9.144
RUN case "$TARGETARCH" in arm64) arch=aarch64 ;; amd64) arch=x86_64 ;; *) exit 1 ;; esac \
    && name="cargo-nextest-${NEXTEST_VERSION}-${arch}-unknown-linux-gnu" \
    && base="https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${NEXTEST_VERSION}" \
    && curl --fail --location --max-time 120 "$base/$name.tar.gz" -o /tmp/nextest.tar.gz \
    && curl --fail --location --max-time 30 "$base/$name.sha256" -o /tmp/nextest.sha256 \
    && echo "$(cut -d ' ' -f 1 /tmp/nextest.sha256)  /tmp/nextest.tar.gz" | sha256sum --check \
    && tar -xzf /tmp/nextest.tar.gz -C /usr/local/cargo/bin cargo-nextest \
    && rm /tmp/nextest.tar.gz /tmp/nextest.sha256

WORKDIR /src
COPY . .
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN cp /usr/local/bin/bun core/resources/bun
ENTRYPOINT ["bash", "scripts/core-test-runner.sh"]
