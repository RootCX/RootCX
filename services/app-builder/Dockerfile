FROM oven/bun:1.3.10@sha256:b86c67b531d87b4db11470d9b2bd0c519b1976eee6fcd71634e73abfa6230d2e AS bun
FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap socat ca-certificates tar git curl ripgrep \
    && rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=rootcx-skills skills/rootcx /opt/rootcx-skills/rootcx
# Under /usr so both the coding sandbox and the publication checks can execute the pinned CLI.
# The official OpenSpec skills for OpenCode are generated by that same release; archiving is the platform's job.
COPY services/app-builder/tools/openspec /usr/local/lib/openspec
RUN npm ci --prefix /usr/local/lib/openspec --ignore-scripts --omit=dev --no-audit --no-fund \
    && ln -s /usr/local/lib/openspec/node_modules/@fission-ai/openspec/bin/openspec.js /usr/local/bin/openspec \
    && mkdir /tmp/openspec-skills && cd /tmp/openspec-skills \
    && OPENSPEC_TELEMETRY=0 openspec init --tools opencode < /dev/null \
    && cp -R .opencode/skills/openspec-explore .opencode/skills/openspec-propose .opencode/skills/openspec-apply-change .opencode/skills/openspec-update-change /opt/rootcx-skills/ \
    && cd / && rm -rf /tmp/openspec-skills && npm cache clean --force
COPY --from=rootcx-skills scripts/install.sh /tmp/install-rootcx.sh
RUN ROOTCX_INSTALL=/usr/local/lib/rootcx-cli sh /tmp/install-rootcx.sh --no-path-update 0.17.2 \
    && ln -s /usr/local/lib/rootcx-cli/bin/rootcx /usr/local/bin/rootcx && rm /tmp/install-rootcx.sh
WORKDIR /opt/rootcx-builder
COPY services/app-builder/package.json services/app-builder/package-lock.json ./
RUN npm ci --ignore-scripts --omit=dev && npm cache clean --force
COPY services/app-builder/ ./
COPY core/resources/integrations /tmp/integrations
RUN node scripts/package-integrations.mjs /tmp/integrations integrations.md && rm -rf /tmp/integrations \
    && node scripts/package-docs.mjs \
    && mkdir -p /opt/rootcx-builder/empty-config /var/lib/rootcx-builder /var/lib/rootcx-backups \
    && chown node:node /var/lib/rootcx-builder /var/lib/rootcx-backups
USER node
EXPOSE 9201
CMD ["node", "server.mjs"]
