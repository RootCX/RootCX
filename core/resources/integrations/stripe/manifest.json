  "name": "Stripe",
  "version": "1.2.0",
  "type": "integration",
  "description": "Stripe account API access: customers, invoices, payments, subscriptions, refunds and other JSON resources permitted by the connection. Read/write actions are separate; writes require idempotency keys. No multipart uploads, Connect account header routing, or secret passthrough.",
  "entities": [],
  "configSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
