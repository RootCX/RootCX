      "protocolVersion": 1,
      "qualification": "requires-live-verification",
      "discovery": null
    },
    "tokenAuth": {
      "label": "Stripe restricted API key (account read plus read/write permissions for the resources you use)",
      "helpUrl": "https://dashboard.stripe.com/apikeys"
    },
    "oauth": null,
    "credentialSchema": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Stripe restricted API key (account read plus read/write permissions for the resources you use)"
