    {
      "id": "api_read",
      "name": "Read Stripe API",
      "description": "Read any JSON resource on the connected Stripe account via GET. One page only; pass Stripe pagination parameters explicitly. Key permissions apply. [read]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Stripe resource path, without host, query or fragment",
            "pattern": "^/v[12]/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
          },
          "parameters": {
            "type": "object",
            "maxProperties": 200,
            "additionalProperties": true,
            "description": "Stripe API parameters as nested JSON (arrays supported); use provider IDs, never raw card data or credentials."
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "api_write",
      "name": "Write Stripe API",
      "description": "Execute POST or DELETE on the connected Stripe account. Can charge, refund, transfer, delete or send messages: obtain authorization for the intended operation. No automatic retry; v1 DELETE ignores idempotency keys. No multipart uploads or arbitrary headers. [write]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Stripe resource path, without host, query or fragment",
            "pattern": "^/v[12]/[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
          },
          "method": {
            "type": "string",
            "enum": [
              "POST",
              "DELETE"
            ]
          },
          "parameters": {
            "type": "object",
            "maxProperties": 200,
            "additionalProperties": true,
            "description": "Stripe API parameters as nested JSON (arrays supported); use provider IDs, never raw card data or credentials."
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Stable key for one intended operation; reuse with identical parameters only. Reconcile uncertain results before retrying.",
            "pattern": "^[!-~]+$"
          }
        },
        "required": [
          "path",
          "method",
          "idempotencyKey"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
