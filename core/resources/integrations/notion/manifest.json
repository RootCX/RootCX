{
  "appId": "notion",
  "name": "Notion",
  "version": "1.0.0",
  "type": "integration",
  "description": "Connect Notion and operate on live data.",
  "entities": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "clientId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "OAuth client ID",
        "platformSecret": "NOTION_CLIENT_ID"
      },
      "clientSecret": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "OAuth client secret",
        "platformSecret": "NOTION_CLIENT_SECRET"
      },
      "tokenUrl": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "",
        "const": "https://api.notion.com/v1/oauth/token",
        "platformSecret": "NOTION_TOKEN_URL"
      },
      "tokenAuthMethod": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "",
        "const": "basic",
        "platformSecret": "NOTION_TOKEN_AUTH_METHOD"
      },
      "tokenEncoding": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "",
        "const": "json",
        "platformSecret": "NOTION_TOKEN_ENCODING"
      }
    },
    "required": [
      "clientId",
      "clientSecret",
      "tokenUrl"
    ],
    "additionalProperties": false
  },
  "userAuth": {
    "type": "oauth2",
    "plugin": {
      "protocolVersion": 1,
      "qualification": "requires-live-verification",
      "discovery": {
        "action": "list_sources",
        "itemsPath": "items",
        "idPath": "id",
        "labelPath": "titleText"
      }
    },
    "tokenAuth": {
      "label": "Notion internal integration secret",
      "helpUrl": "https://www.notion.so/profile/integrations"
    },
    "oauth": {
      "scopes": [],
      "tokenUrl": "https://api.notion.com/v1/oauth/token",
      "tokenAuthMethod": "basic",
      "tokenEncoding": "json"
    },
    "credentialSchema": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Notion internal integration secret"
        }
      },
      "required": [
        "accessToken"
      ],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "verify_connection",
      "name": "Verify connection",
      "description": "Verify the connected account with the provider [read]",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "list_sources",
      "name": "List data sources",
      "description": "Discover accessible Notion data sources [read]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Opaque cursor from the previous response"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": ""
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "get_schema",
      "name": "Get source schema",
      "description": "Retrieve native Notion property definitions [read]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dataSourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "dataSourceId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "query_entries",
      "name": "Query entries",
      "description": "Query one page using native Notion filters and sorts [read]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dataSourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Opaque cursor from the previous response"
          },
          "filter": {
            "type": "object",
            "maxProperties": 200,
            "additionalProperties": true
          },
          "sorts": {
            "type": "array",
            "items": {
              "type": "object",
              "maxProperties": 200,
              "additionalProperties": true
            },
            "maxItems": 100
          }
        },
        "required": [
          "dataSourceId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "get_entry",
      "name": "Get entry",
      "description": "Read a page and its native properties [read]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "pageId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "create_entry",
      "name": "Create entry",
      "description": "Create a page in a data source. Never automatically retry an uncertain creation. [write]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dataSourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "properties": {
            "type": "object",
            "maxProperties": 200,
            "additionalProperties": true,
            "minProperties": 1,
            "description": "Native Notion property objects keyed by property name or ID; get_schema returns the expected types."
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "maxProperties": 200,
              "additionalProperties": true
            },
            "maxItems": 100
          }
        },
        "required": [
          "dataSourceId",
          "properties"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "update_entry",
      "name": "Update entry",
      "description": "Update properties of the existing Notion page [write]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "properties": {
            "type": "object",
            "maxProperties": 200,
            "additionalProperties": true,
            "minProperties": 1,
            "description": "Native Notion property objects keyed by property name or ID; get_schema returns the expected types."
          }
        },
        "required": [
          "pageId",
          "properties"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ],
  "instructions": "RootCX integration plugin protocol 1. Connect an account and bind it to the application. Credentials and permissions belong to Core. Reads are live. Use discovery and schema actions before writing. Follow nextCursor explicitly. Never retry an uncertain write automatically; reconcile with the provider. Only the listed actions are supported. Provider qualification is required before production activation."
}
