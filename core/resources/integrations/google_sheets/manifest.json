{
  "appId": "google_sheets",
  "name": "Google Sheets",
  "version": "1.0.0",
  "type": "integration",
  "description": "Connect Google Sheets and operate on live data.",
  "entities": [],
  "configSchema": {
    "type": "object",
    "properties": {
      "clientId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "OAuth client ID",
        "platformSecret": "GOOGLE_SHEETS_CLIENT_ID"
      },
      "clientSecret": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "OAuth client secret",
        "platformSecret": "GOOGLE_SHEETS_CLIENT_SECRET"
      },
      "tokenUrl": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "",
        "const": "https://oauth2.googleapis.com/token",
        "platformSecret": "GOOGLE_SHEETS_TOKEN_URL"
      },
      "tokenAuthMethod": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "",
        "const": "body",
        "platformSecret": "GOOGLE_SHEETS_TOKEN_AUTH_METHOD"
      },
      "tokenEncoding": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "description": "",
        "const": "form",
        "platformSecret": "GOOGLE_SHEETS_TOKEN_ENCODING"
      }
    },
    "required": [
      "clientId",
      "clientSecret",
      "tokenUrl"
    ],
    "additionalProperties": false
  },
  "userAuth": {
    "type": "oauth2",
    "plugin": {
      "protocolVersion": 1,
      "qualification": "requires-live-verification",
      "discovery": {
        "action": "list_spreadsheets",
        "itemsPath": "items",
        "idPath": "id",
        "labelPath": "name"
      }
    },
    "tokenAuth": null,
    "oauth": {
      "scopes": [
        "openid",
        "email",
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/drive.metadata.readonly"
      ],
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "tokenAuthMethod": "body",
      "tokenEncoding": "form"
    },
    "credentialSchema": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Access token"
        }
      },
      "required": [
        "accessToken"
      ],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "verify_connection",
      "name": "Verify connection",
      "description": "Verify the connected account with the provider [read]",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "list_spreadsheets",
      "name": "List spreadsheets",
      "description": "Discover accessible spreadsheet files [read]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Opaque cursor from the previous response"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "get_schema",
      "name": "Get spreadsheet structure",
      "description": "Read worksheet IDs, titles and dimensions [read]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "spreadsheetId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "read_range",
      "name": "Read range",
      "description": "Read a bounded A1 range; ranges are coordinates, not stable record IDs [read]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "A1 range including sheet name, e.g. Sheet1!A1:C10"
          }
        },
        "required": [
          "spreadsheetId",
          "range"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "append_rows",
      "name": "Append rows",
      "description": "Append rows to a table. Reconcile uncertain writes; never retry automatically. [write]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "A1 range including sheet name, e.g. Sheet1!A1:C10"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "maxItems": 1000
            },
            "maxItems": 1000
          }
        },
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
    {
      "id": "update_range",
      "name": "Update range",
      "description": "Write RAW values to explicit coordinates; empty string clears a cell and null skips it [write]",
      "inputSchema": {
        "type": "object",
        "properties": {
          "spreadsheetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Provider identifier",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "A1 range including sheet name, e.g. Sheet1!A1:C10"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "maxItems": 1000
            },
            "maxItems": 1000
          }
        },
        "required": [
          "spreadsheetId",
          "range",
          "values"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ],
  "instructions": "RootCX integration plugin protocol 1. Connect an account and bind it to the application. Credentials and permissions belong to Core. Reads are live. Use discovery and schema actions before writing. Follow nextCursor explicitly. Never retry an uncertain write automatically; reconcile with the provider. Only the listed actions are supported. Provider qualification is required before production activation."
}
